# Copier vers apps/mobile/.env (non versionné)

EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# --- AdMob : IDs de TEST Google (dev / Expo Go ne suffit pas pour voir les bannières) ---
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID="ca-app-pub-3940256099942544~3347511713"
# EXPO_PUBLIC_ADMOB_BANNER_ID="ca-app-pub-3940256099942544/6300978111"

# --- AdMob : IDs RÉELS (compte admob.google.com → Apps → homeshared → Unités) ---
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID="ca-app-pub-XXXXXXXX~YYYYYYYYYY"
# EXPO_PUBLIC_ADMOB_BANNER_ID="ca-app-pub-XXXXXXXX/ZZZZZZZZZZ"
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=""
# EXPO_PUBLIC_ADMOB_REWARDED_ID=""

# true = afficher les pubs (dev). En prod : bandeau RGPD (UMP) avant v1.1.
EXPO_PUBLIC_ADS_CONSENT="true"

# Build EAS preview/production : utiliser les vrais unit IDs (voir docs/PUBLICATION-ANDROID-ADS.md)
# EXPO_PUBLIC_ADS_USE_REAL_UNITS="true"

# --- Production (Vercel + Play Store) — voir docs/DEPLOYMENT.md ---
# EXPO_PUBLIC_SITE_URL="https://homeshared.vercel.app"
# EXPO_PUBLIC_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.steve.homeshared"
# APK web : par défaut /download.apk sur le même domaine (fichier dans public/download.apk)
# EXPO_PUBLIC_APK_URL="https://homeshared.vercel.app/download.apk"
