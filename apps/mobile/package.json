{
  "name": "@homeshared/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../node_modules/expo/bin/cli start",
    "start:clear": "node ../../node_modules/expo/bin/cli start -c",
    "android": "expo run:android",
    "web": "node ../../node_modules/expo/bin/cli start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,tsx}\" --ignore-pattern node_modules",
    "test": "echo \"no tests yet\" && exit 0",
    "build": "echo \"use 'pnpm build:web' or eas build for android\" && exit 0",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/metro-runtime": "~3.2.3",
    "@homeshared/shared": "workspace:*",
