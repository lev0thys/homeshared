{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_ADS_USE_REAL_UNITS": "true"
      },
      "node": "22.11.0",
      "pnpm": "9.15.5"
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_ADS_USE_REAL_UNITS": "true",
        "EXPO_NO_ANDROID_WIDGETS": "true"
      },
      "node": "22.11.0",
      "pnpm": "9.15.5"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../../play-store/service-account.json",
        "track": "internal"
      },
      "ios": {}
    }
  }
}
