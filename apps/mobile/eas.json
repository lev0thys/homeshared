{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_ADS_USE_REAL_UNITS": "true"
      },
      "node": "22.11.0",
      "pnpm": "9.15.5"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ADS_USE_REAL_UNITS": "true"
      },
      "node": "22.11.0",
      "pnpm": "9.15.5"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../../play-store/service-account.json",
        "track": "internal"
      }
    }
  }
}
