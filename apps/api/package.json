{
  "name": "@homeshared/api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "prisma:db-push": "dotenv -e ../../.env -- prisma db push",
    "prisma:migrate-catalog": "dotenv -e ../../.env -- tsx prisma/migrate-to-ingredient-catalog.ts",
    "metrics:weekly": "tsx scripts/weekly-metrics.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@homeshared/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.46.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
