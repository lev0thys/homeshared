# --- API ---
# Local Docker : `docker compose up -d` puis ces deux URLs identiques.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeshared?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeshared?schema=public"

# Supabase (recommandé en dev/prod) — voir docs/SETUP-STEVE.md étape 1 :
# DATABASE_URL = pooler transaction (port 6543, ?pgbouncer=true&connection_limit=1)
# DIRECT_DATABASE_URL = connexion directe (port 5432) pour `prisma db push` / migrate

# Logs SQL Prisma en dev (optionnel, verbeux) :
# PRISMA_LOG_QUERIES=1

JWT_SECRET="change-me-with-a-random-string-of-at-least-32-chars"
PORT=3001
NODE_ENV="development"

# Limite globale par IP (routes /health exclues). Ajuster en prod si besoin.
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW="1 minute"

# --- Mobile (dupliquer aussi dans apps/mobile/.env) ---
# EXPO_PUBLIC_API_URL="http://localhost:3001"
# EXPO_PUBLIC_SUPABASE_URL=""
# EXPO_PUBLIC_SUPABASE_ANON_KEY=""
# AdMob : voir apps/mobile/.env.example et docs/PUBLICATION-ANDROID-ADS.md